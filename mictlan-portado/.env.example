TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://usuario:password@localhost:5432/mictlan
ROOT_ID=8513204887
ADMIN_GROUP_ID=-1003939023898

# Opcional -- solo si algun modulo externo usa contexto.proxy (ver
# CONTRATO_SDK_MODULOS.md). Sin esta variable, contexto.proxy.url()
# levanta ProxyNoConfigurado -- el bot arranca igual sin ella.
DATAIMPULSE_PROXY_URL=

# Opcionales -- logging propio (ver mictlan/logging_setup.py). Sin estas
# variables, log a "mictlan.log" (relativo al directorio de arranque) en
# nivel INFO. Si se corren main.py y mictlantecuhtli.py en la misma
# maquina, usar rutas DISTINTAS para cada uno (ej. mictlan.log /
# mictlantecuhtli.log) -- si no, los dos procesos escriben al mismo
# archivo rotativo y se pisan entre si.
MICTLAN_LOG_PATH=
MICTLAN_LOG_LEVEL=

# Mictlantecuhtli (mictlantecuhtli.py) -- segundo bot de respaldo,
# proceso separado. Requiere un token de Telegram PROPIO (vía
# @BotFather, nunca el mismo que TELEGRAM_BOT_TOKEN) agregado como
# administrador (con permiso de restringir miembros) en cada grupo que
# deba poder proteger. Sin esta variable, mictlantecuhtli.py no arranca
# -- main.py (el bot principal) arranca igual sin ella, el heartbeat
# simplemente no tiene quién lo lea.
MICTLANTECUHTLI_BOT_TOKEN=

# Todas opcionales, con default razonable -- ver mictlan/tecuhtli/estado.py.
TECUHTLI_HEARTBEAT_INTERVAL_SEGUNDOS=
TECUHTLI_EVALUAR_INTERVALO_SEGUNDOS=
TECUHTLI_ALERTA_SEGUNDOS=
TECUHTLI_CRITICO_SEGUNDOS=
TECUHTLI_RESPALDO_SEGUNDOS=
TECUHTLI_VENTANA_RECUPERACION_SEGUNDOS=

# Sin default -- sin esta variable, /reactivar nunca puede completarse
# (compara siempre contra string vacío, que reactivar_command rechaza a
# propósito). Nunca compartir este valor fuera de .env.
TECUHTLI_SECRETO_RECUPERACION=
